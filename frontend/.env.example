# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (pooled endpoint).
#
# The app uses Neon's serverless HTTP driver, so this must be a Neon host.
# For local work, preview deploys or tests, create a Neon branch and point
# this at the branch's connection string — that keeps one driver and one code
# path between development and production.
#
# Dashboard -> your project -> Connection Details -> "Pooled connection".
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Canonical public origin, used by sitemap.xml, robots.txt and canonical links.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically, so
# set it explicitly only once you have a real domain.
# NEXT_PUBLIC_SITE_URL="https://offscript.app"

# ---------------------------------------------------------------------------
# Clerk authentication — from the Clerk dashboard (https://dashboard.clerk.com)
# API Keys page, or run `clerk env pull`.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# Where Clerk's hosted sign-in / sign-up UI is mounted in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Where to land after auth when there is no explicit redirect target.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"
